# 3D AI Lab — yapılandırma. `infra/scripts/setup-linux.sh` bunu .env olarak kopyalar
# ve rastgele bir APP_TOKEN üretir. Tüm servisler (gateway, frontend, worker'lar)
# aynı .env'i okur.

# === Auth ===
# Üret: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=CHANGE_ME_TO_RANDOM_32_BYTES
# true → bu makineden (localhost) açılan tarayıcı giriş ekranını atlar.
# LAN'daki diğer cihazlar yine kullanıcı adı/parola ya da token ile girer.
AUTO_LOGIN=false

# === Server ===
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9000
FRONTEND_PORT=3000
# Frontend başka bir host/port'tan açılacaksa ekle (virgülle ayrılmış).
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Broker ===
REDIS_URL=redis://127.0.0.1:6379/0
# Redis'i parola ile çalıştırıyorsan: redis://:PAROLA@127.0.0.1:6379/0
# (LAN'a açıksan ŞART — bkz. SECURITY.md).

# === GPU ===
# Tek doğruluk kaynağı. Tek GPU'lu makine → 0 (varsayılan). Birden fazla kartta
# üretimi başka karta yönlendirmek için o kartın index'ini ver (ör. 1).
DEFAULT_GPU=0
# Boş → cihaz sayısı otomatik saptanır. Kısıtlamak için: "0" ya da "0,1".
VISIBLE_GPUS=

# === Motorlar ===
# start-linux.sh hangi worker'ları başlatsın:
#   auto  → kurulu olan tüm motorlar + clothsim + cloud (varsayılan)
#   liste → ör. "trellis triposr clothsim cloud"
ENABLED_ENGINES=auto
# Upstream klonları, ortamları ve ağırlıkların yeri (boş → <repo>/engines).
# ENGINES_DIR=/data/3d-ai-lab-engines

# === Veri ===
# Boş bırak → <repo>/data. Taşımak için MUTLAK yol ver (göreli yol worker'larda
# farklı dizine çözülür). Alt dizinler (projects, uploads, …) buradan türetilir.
# DATA_DIR=/data/3d-ai-lab
# DATABASE_URL=sqlite:////data/3d-ai-lab/clothing.db

# === Hugging Face (kapılı modeller için) ===
# FLUX, SF3D, Hunyuan, SAM 3D gibi ağırlıklar lisans onayı + token ister:
# huggingface.co/settings/tokens → modelin sayfasında erişim iste → token'ı buraya koy.
HF_TOKEN=

# === Çeviri ===
# Gateway tarafı: none (varsayılan) | argos (uv sync --extra translate gerekir).
# Türkçe prompt'lar GPU worker'ında opus-mt ile çevrilir (WORKER_TRANSLATE_BACKEND).
TRANSLATE_BACKEND=none
# WORKER_TRANSLATE_BACKEND=opus

# === Şablon kaynağı (opsiyonel CC0 indirme; boşsa prosedürel kullanılır) ===
# Key al: https://poly.pizza/api
POLY_PIZZA_API_KEY=

# === Güvenlik filtresi (opsiyonel NSFW taraması) ===
# off → tarama yok (varsayılan) · log → yalnız logla · block → reddet.
# opennsfw2 flux_motif ortamında opsiyoneldir: pip install opennsfw2
SAFETY_FILTER=off
SAFETY_THRESHOLD=0.85

# === Logging ===
LOG_LEVEL=INFO
# LOG_DIR=/var/log/3d-ai-lab

# === Bulut API motorları (opsiyonel, ücretli) ===
# Boş bırakılan sağlayıcının motorları arayüzde kilitli (🔒) görünür. Anahtar ekledikten
# sonra servisleri yeniden başlat. Ayrıntı: docs/CLOUD_API_REFERENCE.md
TRIPO_API_KEY=
MESHY_API_KEY=
RODIN_API_KEY=
FAL_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
GOOGLE_API_KEY=
BFL_API_KEY=
IDEOGRAM_API_KEY=
RECRAFT_API_KEY=
