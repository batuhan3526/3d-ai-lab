+    @torch.no_grad()
+    def _apply_region_mask(self, mask_path):
+        # UV-uzayi maske (beyaz=yeniden boya, siyah=koru). albedo [H,W] ile hizali.
+        import cv2, os
+        h = w = int(self.opt.texture_size)
+        m = cv2.imread(mask_path, cv2.IMREAD_GRAYSCALE)
+        if m is None:
+            raise FileNotFoundError('region_mask okunamadi: ' + str(mask_path))
+        m = cv2.resize(m, (w, h), interpolation=cv2.INTER_NEAREST)
+        if os.environ.get('REGION_MASK_FLIP_V', '0') == '1':
+            m = m[::-1].copy()
+        if os.environ.get('REGION_MASK_FLIP_U', '0') == '1':
+            m = m[:, ::-1].copy()
+        mask = (torch.from_numpy(m).to(self.device).float() / 255.0) > 0.5
+        # F5: is sonunda maske disini birebir geri yuklemek icin sakla —
+        # deblur()/sr ve view-inpaint sizintilari korunan dokuyu da degistiriyordu
+        self._region_mask_t = mask
+        self._region_keep_albedo = self.albedo.clone()
+        self.albedo[mask] = 0
+        self.cnt[mask] = 0
+        self.renderer.mesh.viewcos_cache[mask] = -1
+        self.renderer.mesh.albedo = self.albedo
+        self.renderer.mesh.cnt = self.cnt
+        print('[F5] region_mask uygulandi: ' + str(int(mask.sum().item())) + ' px yeniden boyanacak')
+
